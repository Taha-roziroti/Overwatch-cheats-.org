---
import { defaultLocale, isLocaleCode, localeCodes } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return localeCodes
		.filter((code) => code !== defaultLocale)
		.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/forum/', 301);
}

return Astro.redirect('/forum/', 301);
---
