---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);

const categories = [
	{ label: t('categoryRow.hacks'), href: getLocalizedPath('hacks', locale) },
	{ label: t('categoryRow.esp'), href: getLocalizedPath('overwatch-2-esp', locale) },
	{ label: t('categoryRow.aimbot'), href: getLocalizedPath('overwatch-2-aimbot', locale) },
	{ label: t('categoryRow.wallhack'), href: getLocalizedPath('radar', locale) },
	{ label: t('categoryRow.undetected'), href: getLocalizedPath('undetected', locale) },
	{ label: t('categoryRow.pricing'), href: getLocalizedPath('pricing', locale) },
	{ label: t('categoryRow.setup'), href: getLocalizedPath('setup', locale) },
];
---

<nav class="cats" aria-label={t('common.browse')}>
	<div class="shell">
		<ul class="cats__list">
			{
				categories.map((cat) => (
					<li>
						<a href={cat.href}>{cat.label}</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<style>
	.cats {
		border-block: 1px solid var(--line-soft);
		background: var(--bg-panel);
	}

	.cats__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--line);
	}

	.cats__list li {
		border-right: 1px solid var(--line);
	}

	.cats__list li:last-child {
		border-right: none;
	}

	.cats__list a {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: none;
		border-radius: 0;
		background: var(--bg-panel);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-muted);
		transition: color 0.15s ease, background 0.15s ease;
	}

	.cats__list a:hover {
		background: var(--bg-elevated);
	}

	.cats__list a:hover {
		color: var(--ink);
		border-color: color-mix(in srgb, var(--magenta) 45%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, var(--bg-elevated));
	}

	@media (max-width: 720px) {
		.cats__list {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			margin-inline: calc(var(--page-gutter) * -1);
			padding-inline: var(--page-gutter);
			padding-bottom: 0.15rem;
			-webkit-overflow-scrolling: touch;
		}

		.cats__list::-webkit-scrollbar {
			display: none;
		}

		.cats__list a {
			white-space: nowrap;
			flex-shrink: 0;
			min-height: var(--touch-min, 2.75rem);
			padding-inline: 1rem;
		}
	}
</style>
