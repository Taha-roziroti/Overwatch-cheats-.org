---
import HomeSeoApp from './react/HomeSeo';
import { homeFaqs } from '../data/site';
import { getFaqPath } from '../data/faq';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const faqs = homeFaqs.map((item) => ({
	slug: item.slug,
	question: item.question,
	answer: item.answer,
	href: getFaqPath(item.slug),
}));
---

<HomeSeoApp client:visible locale={locale} faqs={faqs} />

<style is:global>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-seo__head {
		margin-bottom: 1.35rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--line-soft);
		text-align: center;
	}

	.home-seo__head > div {
		max-width: 40rem;
		margin-inline: auto;
	}

	.home-seo__section-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
	}

	.home-seo__section-sub {
		margin: 0.4rem 0 0;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink-muted);
	}

	.home-seo__lede {
		margin: 0.45rem auto 0;
		max-width: 36rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.home-seo__cats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
		align-items: stretch;
		width: 100%;
	}

	.home-seo__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-seo__cat:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__cat-head {
		padding: 1rem 0.85rem 0.85rem;
		border-bottom: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
		text-align: center;
	}

	.home-seo__cat-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.home-seo__cat-head p {
		margin: 0.35rem 0 0;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.home-seo__cat ul {
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		display: grid;
		flex: 1;
	}

	.home-seo__cat a {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 0.85rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.home-seo__cat-arrow {
		display: none;
	}

	.home-seo__cat a:hover {
		background: color-mix(in srgb, var(--accent) 8%, transparent);
		color: var(--accent);
	}

	.home-seo__faq {
		margin-top: 2.25rem;
		margin-inline: auto;
		width: 100%;
		max-width: 40rem;
		padding: clamp(1.35rem, 3vw, 1.85rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 70% 80% at 100% 0%, color-mix(in srgb, var(--magenta) 10%, transparent), transparent 50%),
			var(--bg-panel);
	}

	.home-seo__faq-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		margin-bottom: 1.15rem;
		padding-bottom: 1.05rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__faq-head > div {
		max-width: 36rem;
	}


	.home-seo__faq-lede {
		margin: 0.45rem 0 0;
		max-width: 36rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.home-seo__faq-link {
		flex-shrink: 0;
		margin-top: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
		white-space: nowrap;
	}

	.home-seo__faq-link:hover {
		color: var(--ink);
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.45rem;
	}

	.home-seo__item {
		margin: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg) 55%, var(--bg-elevated));
		overflow: hidden;
	}

	.home-seo__item[open],
	.home-seo__item:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		padding: 0.95rem 1.05rem;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink);
		text-align: left;
	}

	.home-seo__item summary > span:first-child {
		flex: 1;
		min-width: 0;
	}

	.home-seo__item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__item[open] summary {
		border-bottom: 1px solid var(--line-soft);
		color: var(--magenta-soft);
	}

	.home-seo__chev {
		position: relative;
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
	}

	.home-seo__chev::before,
	.home-seo__chev::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background: var(--magenta-soft);
		border-radius: 999px;
	}

	.home-seo__chev::before {
		width: 0.45rem;
		height: 1.5px;
		transform: translate(-50%, -50%);
	}

	.home-seo__chev::after {
		width: 1.5px;
		height: 0.45rem;
		transform: translate(-50%, -50%);
	}

	.home-seo__item[open] .home-seo__chev::after {
		opacity: 0;
	}

	.home-seo__item-body {
		display: grid;
		gap: 0.65rem;
		padding: 0.85rem 1.05rem 1.05rem;
	}

	.home-seo__item-body p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.home-seo__item-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__item-link:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-seo__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.home-seo__faq-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.home-seo__faq-link {
			margin-top: 0;
			min-height: var(--touch-min, 2.75rem);
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.home-seo__cats {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-seo__faq {
			padding: 1.1rem 1rem 1.15rem;
			margin-top: 1.75rem;
		}

		.home-seo__item summary {
			min-height: var(--touch-min, 2.75rem);
			padding: 0.85rem 1rem;
		}
	}
</style>
