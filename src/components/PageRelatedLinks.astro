---
import type { PageId } from '../data/i18n/content.generated';
import { getRelatedPageLinks } from '../data/page-related-links';
import { localizeInternalHref } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	pageId: PageId;
	locale: LocaleCode;
}

const { pageId, locale } = Astro.props;
const links = getRelatedPageLinks(pageId);
const t = getT(locale);

if (links.length === 0) return;
---

<section class="page-related" aria-label={t('common.relatedPages')}>
	<h2>{t('common.relatedPages')}</h2>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={localizeInternalHref(link.href, locale)}>{link.label}</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.page-related {
		margin-top: 0.5rem;
		padding: 1.15rem 1.25rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-panel);
	}

	.page-related h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--ink);
	}

	.page-related ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.65rem;
	}

	.page-related a {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		color: var(--ink-muted);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.page-related a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}
</style>
