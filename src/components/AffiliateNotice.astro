---
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const disclosure = t('affiliate.disclosure');
const pageLink = t('affiliate.pageLink');
const href = getLocalizedPath('affiliate-disclosure', locale);
---

<p class="affiliate-notice">
	{disclosure}
	<a href={href}>{pageLink}</a>
</p>

<style>
	.affiliate-notice {
		margin: 0;
		padding: 0.45rem 0;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.affiliate-notice a {
		margin-left: 0.35rem;
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}
</style>
