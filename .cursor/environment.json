{
  "name": "Destiny 2 Cheats",
  "install": "npm ci",
  "start": "npm run sync:brand",
  "ports": [
    {
      "name": "dev",
      "port": 4321
    },
    {
      "name": "preview",
      "port": 8080
    }
  ],
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev",
      "description": "Astro dev server at http://localhost:4321"
    },
    {
      "name": "tunnel",
      "command": "npx --yes localtunnel --port 4321",
      "description": "Public URL for browsing when localhost port-forward is unavailable"
    }
  ]
}
